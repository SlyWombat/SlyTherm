[Unit]
Description=SlyTherm LAN OTA mirror sync (populates the directory ota-mirror nginx serves)
Documentation=https://github.com/SlyWombat/SlyTherm/blob/main/deploy/ota-mirror/README.md
After=network-online.target
Wants=network-online.target
# The script never exits on a fetch failure (it keeps serving and reports in
# status.json), so a death here is a crash/OOM/watchdog kill. Ten of those in
# an hour = something is actually broken: stop restarting, enter "failed", and
# let OnFailure (drop-in) page. After fixing: systemctl reset-failed; start.
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=all
User=dave
Group=dave
ExecStart=/usr/local/sbin/ota_mirror_sync.sh --dir /data/stacks/ota-mirror/mirror --interval 300 --stale-after 3600
Restart=always
RestartSec=60
# One pass pings the watchdog before every download; a hung curl is capped at
# 900 s by the script, so 30 min without a ping means the loop is wedged.
WatchdogSec=1800
TimeoutStartSec=1200
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/stacks/ota-mirror/mirror

[Install]
WantedBy=multi-user.target
